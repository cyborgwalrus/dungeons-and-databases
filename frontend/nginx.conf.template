server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  location = /admin {
    return 302 /admin/dashboard/;
  }

  location = /admin/ {
    return 302 /admin;
  }

  location = /admin/dashboard {
    return 301 /admin/dashboard/;
  }

  location ^~ /admin/dashboard/ {
    proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/admin/dashboard/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/dashboard;
  }

  location = /admin/adminer {
    return 301 /admin/adminer/;
  }

  location ^~ /admin/adminer/ {
    proxy_pass http://adminer:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/adminer;
    proxy_redirect / /admin/adminer/;
  }

  location /api/ {
    proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  location /apidocs {
    proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/apidocs;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /apispec_1.json {
    proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/apispec_1.json;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /flasgger_static/ {
    proxy_pass http://__BACKEND_HOST__:__BACKEND_PORT__/flasgger_static/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    try_files $uri $uri/ /index.html;
    access_log off;
  }
}