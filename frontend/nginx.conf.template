server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  proxy_http_version 1.1;
  proxy_set_header Host dnd-backend-6ymc.onrender.com;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_ssl_server_name on;

  location /api/ {
    proxy_pass https://__BACKEND_PUBLIC_URL__;
    proxy_connect_timeout 60s;
    proxy_read_timeout 60s;
    #access_log off;
  }

  location /apispec_1.json {
    proxy_pass https://__BACKEND_PUBLIC_URL__;
  }

  location /flasgger_static/ {
    proxy_pass https://__BACKEND_PUBLIC_URL__;
  }

  location = /admin {
    return 302 /admin/dashboard/;
  }

  location = /admin/ {
    return 302 /admin;
  }

  location = /admin/dashboard {
    return 301 /admin/dashboard/;
  }

  location ^~ /admin/dashboard/ {
    proxy_pass https://__BACKEND_PUBLIC_URL__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/dashboard;
  }

  location = /admin/adminer {
    return 301 /admin/adminer/;
  }

  location ^~ /admin/adminer/ {
    proxy_pass https://__BACKEND_PUBLIC_URL__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/adminer;
    proxy_redirect / /admin/adminer/;
  }

  location / {
    try_files $uri $uri/ /index.html;
    access_log off;
  }
}