server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver 127.0.0.11 valid=30s; 
  set $backend_url http://__BACKEND_HOST__:__BACKEND_PORT__;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location = /admin {
    return 302 /admin/dashboard/;
  }

  location = /admin/ {
    return 302 /admin;
  }

  location = /admin/dashboard {
    return 301 /admin/dashboard/;
  }

  location ^~ /admin/dashboard/ {
    proxy_pass $backend_url/admin/dashboard/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/dashboard;
  }

  location = /admin/adminer {
    return 301 /admin/adminer/;
  }

  location ^~ /admin/adminer/ {
    proxy_pass $backend_url/admin/adminer/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/adminer;
    proxy_redirect / /admin/adminer/;
  }

  location /api/ {
    
    proxy_pass $backend_url/api/;
    access_log off;
  }

  location /apidocs {
    proxy_pass $backend_url/apidocs;
  }

  location /apispec_1.json {
    proxy_pass $backend_url/apispec_1.json;
  }

  location /flasgger_static/ {
    proxy_pass $backend_url/flasgger_static/;
    
  }

  location / {
    try_files $uri $uri/ /index.html;
    access_log off;
  }
}