server {
  listen __PORT__;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  resolver __DNS_RESOLVER__ valid=30s ipv6=off;

  set $backend_url "https://__BACKEND_URL__";

  proxy_http_version 1.1;
  proxy_set_header Host __BACKEND_URL__;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;

  location /api/ {
    
    proxy_pass $backend_url;
    proxy_ssl_server_name on;


    proxy_connect_timeout 60s;
    proxy_read_timeout 60s;
    #access_log off;
  }

  location /apispec_1.json {
    proxy_pass $backend_url;
  }

  location /flasgger_static/ {
    proxy_pass $backend_url;
    
  }

  location = /admin {
    return 302 /admin/dashboard/;
  }

  location = /admin/ {
    return 302 /admin;
  }

  location = /admin/dashboard {
    return 301 /admin/dashboard/;
  }

  location ^~ /admin/dashboard/ {
    proxy_pass $backend_url;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/dashboard;
  }

  location = /admin/adminer {
    return 301 /admin/adminer/;
  }

  location ^~ /admin/adminer/ {
    proxy_pass $backend_url;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Prefix /admin/adminer;
    proxy_redirect / /admin/adminer/;
  }

  location / {
    try_files $uri $uri/ /index.html;
    access_log off;
  }
}